# Copy this file to .env and change the values. Never commit .env.
POSTGRES_USER=spendlens
POSTGRES_PASSWORD=change-me
POSTGRES_DB=spendlens

# Used when you run Alembic or the API on your own machine (not inside Docker).
# Use the same user, password and database name as above.
DATABASE_URL=postgresql://spendlens:change-me@localhost:5433/spendlens

