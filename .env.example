# Copy this file to .env and change the values. Never commit .env.
POSTGRES_USER=spendlens
POSTGRES_PASSWORD=change-me
POSTGRES_DB=spendlens

# Used when you run Alembic or the API on your own machine (not inside Docker).
# Use the same user, password and database name as above.
DATABASE_URL=postgresql://spendlens:change-me@localhost:5433/spendlens

# Signs login tokens. Use a long random value, e.g. from:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# How long a login token lasts, in minutes.
JWT_EXPIRE_MINUTES=60

# Which model categorizes merchants the rules don't know. "fake" is offline and
# deterministic; it is the only one available so far.
LLM_PROVIDER=fake

# Added in later days:
# GEMINI_API_KEY=
